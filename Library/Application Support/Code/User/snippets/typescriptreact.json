{
  // Place your snippets for typescriptreact here. Each snippet is defined under a snippet name and has a prefix, body and
  // description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the
  // same ids are connected.
  // Example:
  // "Print to console": {
  // 	"prefix": "log",
  // 	"body": [
  // 		"console.log('$1');",
  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }
  "Add Describe Block": {
    "prefix": "tstgrp",
    "body": ["describe('$1', () => {", "  $2", "});"],
    "description": "Add a describe block to a unit test"
  },
  "Add It Block": {
    "prefix": "tstcase",
    "body": ["it('$1', () => {", "  $2", "});"],
    "description": "Add an it block to a unit test"
  },
  "Add afterEach Block": {
    "prefix": "tstae",
    "body": ["afterEach(() => {", "  $2", "});"],
    "description": "Add an afterEach block to a unit test"
  },
  "Add beforeEach Block": {
    "prefix": "tstbe",
    "body": ["beforeEach(() => {", "  $2", "});"],
    "description": "Add a beforeEach block to a unit test"
  },
  "HTTP Testing Connection": {
    "prefix": "tst-http-connection",
    "body": [
      "let connection: MockConnection;",
      "mockBackend.connections.subscribe(c => connection = c);"
    ],
    "description": "Create Mock Connection"
  },
  "HTTP Testing Imports": {
    "prefix": "tst-http-import",
    "body": [
      "import { Http, Response, ResponseOptions, RequestMethod, BaseRequestOptions } from '@angular/http';",
      "import { MockBackend, MockConnection } from '@angular/http/testing';"
    ],
    "description": "Insert common HTTP testing imports"
  },
  "HTTP Testing Setup": {
    "prefix": "tst-http-setup",
    "body": [
      "const opt = new BaseRequestOptions();",
      "mockBackend = new MockBackend();",
      "const http = new Http(mockBackend, opt);"
    ],
    "description": "Insert common HTTP testing setup"
  },
  "Import a TypeScript module": {
    "prefix": "imp",
    "body": ["import { $2 } from '$1';"],
    "description": "Create an import statement in the order that makes sense"
  }
}
